# ==============================================================================
# IELTSPen Ai — TiDB Serverless Cloud (MySQL) & Render Hosting Environment
# "WRITE SMARTER. SCORE HIGHER."
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. TiDB Cloud Serverless Connection (MySQL with SSL required)
# Obtain from TiDB Cloud Console -> Connect -> Connection String
# ------------------------------------------------------------------------------
DATABASE_URL=mysql://<USERNAME>.<root>:<PASSWORD>@gateway01.<region>.prod.aws.tidbcloud.com:4000/ieltspen?ssl={"rejectUnauthorized":true}

# Alternatively, configure individual TiDB connection variables:
# TIDB_HOST=gateway01.<region>.prod.aws.tidbcloud.com
# TIDB_PORT=4000
# TIDB_USER=<USERNAME>.root
# TIDB_PASSWORD=<PASSWORD>
# TIDB_DATABASE=ieltspen

# ------------------------------------------------------------------------------
# 2. JWT Session Encryption Secret (Required for Edge cookie sessions)
# Generate a secure 32+ character random secret
# ------------------------------------------------------------------------------
JWT_SECRET=ieltspen-secret-jwt-key-2026-secure-random-32-chars

# ------------------------------------------------------------------------------
# 3. Founder & Admin Master Account Auto-Provisioning
# Automatically seeded with role 'admin' in TiDB upon startup
# ------------------------------------------------------------------------------
ADMIN_EMAIL=miadkhan.official1@gmail.com
ADMIN_INITIAL_PASSWORD=Admin@IELTSPen2026!
ADMIN_NAME=MD. MIAD IBNA NOOR

# ------------------------------------------------------------------------------
# 4. AI Provider API Keys (Optional environment fallbacks)
# Can also be dynamically managed & rotated in Admin Studio (/admin)
# ------------------------------------------------------------------------------
GEMINI_API_KEY=
GROQ_API_KEY=
OPENROUTER_API_KEY=
MISTRAL_API_KEY=

# ------------------------------------------------------------------------------
# 5. Production Host Configuration (Render / Custom Domain)
# ------------------------------------------------------------------------------
NODE_ENV=production
NEXT_PUBLIC_APP_URL=https://ieltspen-ai.onrender.com
